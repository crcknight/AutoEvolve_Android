<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="阵容编辑"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="站位棋盘 (2x3)"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <GridLayout
            android:id="@+id/grid_positions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择英雄"
            android:textSize="16sp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_heroes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_formation_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="费用: 0"
            android:textSize="16sp"
            android:paddingTop="12dp" />

        <Button
            android:id="@+id/btn_save_formation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存阵容"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_clear_formation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清空棋盘"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已保存阵容"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_manage_formations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="管理已保存阵容（长按删除/改名）"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_saved_formations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:background="#F5F5F5"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
